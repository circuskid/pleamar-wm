// The Build scene in Spanish. The scene and its logic write in English;
// `locale` (the system's language) chooses.
library BuildSpanish {
    translations es {
        "Drag over what you want as a reference · Esc to cancel" = "Arrastra sobre lo que quieras como referencia · Esc para cancelar"
        "The panel to the other side" = "El panel al otro lado"
        "%d pictures" = "%d imágenes"
        "A bar" = "Una barra"
        "A bar along the top, a dock, a clock in a corner, a window… then Done" = "Una barra arriba, un dock, un reloj en una esquina, una ventana… y luego Hecho"
        "A dock" = "Un dock"
        "A key of its own" = "Una tecla propia"
        "A key: %s" = "Una tecla: %s"
        "A piece of the screen as a reference" = "Un trozo de la pantalla como referencia"
        "A private file" = "Un archivo privado"
        "A widget" = "Un widget"
        "Allow" = "Permitir"
        "Allowed" = "Permitido"
        "An app" = "Una app"
        "Ask me to take that out." = "Pídeme que lo quite."
        "BUILDING" = "CONSTRUYENDO"
        "Bar" = "Barra"
        "Before it runs" = "Antes de ejecutarla"
        "Build what is drawn" = "Construir lo dibujado"
        "Building it…" = "Construyéndola…"
        "Calling it %s" = "Llamándola %s"
        "Checking it" = "Comprobándola"
        "Clear the drawing" = "Borrar el dibujo"
        "Close" = "Cerrar"
        "Could not share it: " = "No se ha podido compartir: "
        "Delete it (press twice)" = "Borrarla (pulsa dos veces)"
        "Done" = "Hecho"
        "Draw a box" = "Dibujar un rectángulo"
        "Draw another" = "Dibujar otra"
        "Draw freely" = "Dibujar a mano"
        "Draw the shape of what you want, where you want it" = "Dibuja la forma de lo que quieres, donde lo quieres"
        "Drop a .build.tar.gz someone shared on this panel to open it." = "Suelta aquí un .build.tar.gz que te hayan compartido para abrirlo."
        "Exit" = "Salir"
        "Four pictures at most" = "Cuatro imágenes como mucho"
        "Hidden while you build: %s's «%s». Keep yours and it stays hidden; throw yours away and it comes back." = "Oculto mientras construyes: lo de %s, «%s». Si te quedas la tuya, sigue oculto; si la tiras, vuelve."
        "It does not run: it asks to " = "No se ejecuta: pide "
        "It is a program that runs other programs: it can do anything on your computer." = "Es un programa que ejecuta otros programas: puede hacer cualquier cosa en tu ordenador."
        "It stays as it is, not running. Ask me to change what it asks for." = "Se queda como está, sin ejecutarse. Pídeme que cambie lo que pide."
        "Keep it" = "Quedármela"
        "Leave build mode (Super+B)" = "Salir del modo construcción (Super+B)"
        "Leave this one and draw another" = "Dejar esta y dibujar otra"
        "Looking at it" = "Mirándola"
        "Made with pleamar-wm's Build" = "Hecha con Construir de pleamar-wm"
        "My creations" = "Mis creaciones"
        "New permissions" = "Permisos nuevos"
        "Not allowed" = "No permitido"
        "Not allowed: " = "No permitido: "
        "Not allowed: run «%s», which can %s." = "No permitido: ejecutar «%s», que puede %s."
        "Not signed in: pleamar-wm's control centre › Build, to sign in" = "Sin sesión: centro de control de pleamar-wm › Construir, para iniciarla"
        "Not this" = "Esto no"
        "Nothing copied is a picture" = "Lo que has copiado no es una imagen"
        "Nothing yet: draw something and press Done." = "Nada todavía: dibuja algo y pulsa Hecho."
        "Open" = "Abrir"
        "Open it again" = "Abrirla otra vez"
        "Paste a picture" = "Pegar una imagen"
        "Reading %s" = "Leyendo %s"
        "Reading a private file" = "Leer un archivo privado"
        "Reading pleamar's %s" = "Leyendo «%s» de pleamar"
        "Running %s" = "Ejecutando %s"
        "Running a program" = "Ejecutar un programa"
        "Share" = "Compartir"
        "Shared as %s: give it to anyone, or post it in #share-you-creation." = "Compartida como %s: dásela a quien quieras o publícala en #share-you-creation."
        "Something went wrong: " = "Algo ha fallado: "
        "Stopped." = "Parado."
        "Stopping…" = "Parando…"
        "Tell me what it should be: its colours, its look, what it shows and does. I'll make it right there, as you watch." = "Dime cómo tiene que ser: sus colores, su aspecto, qué muestra y qué hace. Lo haré ahí mismo, mientras miras."
        "That file is not a creation it can open." = "Ese archivo no es una creación que pueda abrir."
        "That is not a picture it can read" = "Eso no es una imagen que pueda leer"
        "That model cannot be used: choose another in the control centre › Build" = "Ese modelo no se puede usar: elige otro en el centro de control › Construir"
        "The builder cannot start: " = "El constructor no puede arrancar: "
        "The builder stopped." = "El constructor se ha parado."
        "The builder wants to read «%s», a file that may hold passwords or keys." = "El constructor quiere leer «%s», un archivo que puede guardar contraseñas o claves."
        "The builder wants to run on your computer, touching files that may hold passwords or keys:" = "El constructor quiere ejecutar en tu ordenador, tocando archivos que pueden guardar contraseñas o claves:"
        "The builder wants to run on your computer:" = "El constructor quiere ejecutar en tu ordenador:"
        "Thinking…" = "Pensando…"
        "Throw away" = "Tirar"
        "Throw it away" = "Tirarla"
        "Trying it: %s" = "Probándola: %s"
        "Undo" = "Deshacer"
        "Undo the last version" = "Deshacer la última versión"
        "Undone: %s" = "Deshecho: %s"
        "Use the desktop" = "Usar el escritorio"
        "Waiting for you" = "Esperándote"
        "Waking the builder up…" = "Despertando al constructor…"
        "What should it be?" = "¿Qué tiene que ser?"
        "What you built" = "Lo que has construido"
        "Writing %s" = "Escribiendo %s"
        "a picture" = "una imagen"
        "answer and clear notifications" = "responder y borrar notificaciones"
        "change how files can be changed" = "cambiar cómo se pueden modificar los archivos"
        "change passwords" = "cambiar contraseñas"
        "change the disks' partitions" = "cambiar las particiones de los discos"
        "change the firewall" = "cambiar el cortafuegos"
        "change the screen's brightness" = "cambiar el brillo de la pantalla"
        "change the volume" = "cambiar el volumen"
        "change the volume and the sound devices" = "cambiar el volumen y los dispositivos de sonido"
        "change users" = "cambiar usuarios"
        "change who can open files" = "cambiar quién puede abrir archivos"
        "change who owns files" = "cambiar de quién son los archivos"
        "check your password" = "comprobar tu contraseña"
        "close programs" = "cerrar programas"
        "connect and disconnect Bluetooth devices" = "conectar y desconectar dispositivos Bluetooth"
        "connect to other computers" = "conectarse a otros ordenadores"
        "control the music that is playing" = "controlar la música que suena"
        "copy files elsewhere" = "copiar archivos a otro sitio"
        "copy over files" = "copiar encima de archivos"
        "create users" = "crear usuarios"
        "delete files" = "borrar archivos"
        "delete folders" = "borrar carpetas"
        "delete users" = "borrar usuarios"
        "destroy files" = "destruir archivos"
        "do things as another user" = "hacer cosas como otro usuario"
        "do things as the administrator" = "hacer cosas como administrador"
        "empty files" = "vaciar archivos"
        "end sessions" = "cerrar sesiones"
        "erase disks" = "borrar discos"
        "install or remove software" = "instalar o quitar programas"
        "kept" = "guardada"
        "log out, restart or turn off the computer" = "cerrar la sesión, reiniciar o apagar el ordenador"
        "mount disks" = "montar discos"
        "move and close your windows" = "mover y cerrar tus ventanas"
        "move and replace files" = "mover y sustituir archivos"
        "not kept" = "sin guardar"
        "open network connections" = "abrir conexiones de red"
        "open programs" = "abrir programas"
        "put things in what you copy" = "poner cosas en lo que copias"
        "read the session's settings (environment)" = "leer los ajustes de la sesión (el entorno)"
        "read what you copy" = "leer lo que copias"
        "replace files" = "sustituir archivos"
        "restart the computer" = "reiniciar el ordenador"
        "run things on its own at times" = "ejecutar cosas por su cuenta a ciertas horas"
        "run «%s», a program it does not know" = "ejecutar «%s», un programa que no conoce"
        "run «%s», which can %s" = "ejecutar «%s», que puede %s"
        "run «%s»: a program that runs other programs. Through it, this creation could do anything on your computer" = "ejecutar «%s»: un programa que ejecuta otros programas. Con él, esta creación podría hacer cualquier cosa en tu ordenador"
        "run «%s»: only that script, nothing else" = "ejecutar «%s»: solo ese script, nada más"
        "send files to other computers" = "enviar archivos a otros ordenadores"
        "start, stop and change system services" = "arrancar, parar y cambiar servicios del sistema"
        "stop the computer" = "detener el ordenador"
        "switch workspaces" = "cambiar de escritorio"
        "turn the computer off" = "apagar el ordenador"
        "turn the network on and off, and connect to Wi-Fi" = "encender y apagar la red, y conectarse al Wi-Fi"
        "unmount disks" = "desmontar discos"
        "use the icons in the tray" = "usar los iconos de la bandeja"
        "use «%s» of the system" = "usar «%s» del sistema"
        "write files" = "escribir archivos"
        "write straight onto disks" = "escribir directamente en los discos"
        "«%s» comes from someone else, and wants to:" = "«%s» viene de otra persona y quiere:"
        "«%s» is running. Ask me to change anything in it." = "«%s» ya funciona. Pídeme que cambie lo que quieras."
        "«%s» wants the key %s to: %s" = "«%s» quiere la tecla %s para: %s"
        "«%s» wants to:" = "«%s» quiere:"
