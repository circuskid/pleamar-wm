# What starts with the desktop, one command a line, run with `sh -c`. Yours goes
# in ~/.config/pleamar/autostart: pleamar-wm's session runs it, and on another
# compositor (Hyprland: `exec-once = pleamar --autostart`) so does pleamar.
# A line that only makes sense in pleamar-wm's session starts with `wm:`.
#
# The wallpaper: the one Marea has saved (session.sh reads it), under everything.
# Without that picture, a plain colour; without swaybg, the log says so.
wm: w="${PLEAMAR_WALLPAPER:-/usr/share/wallpapers/cachyos-wallpapers/GreenFeathers.png}"; if ! command -v swaybg > /dev/null; then echo "autostart · swaybg is not installed: the desktop has no wallpaper (install swaybg)" >&2; elif [ -f "$w" ]; then exec swaybg -i "$w" -m fill; else echo "autostart · no picture at $w: a plain colour instead" >&2; exec swaybg -c '#12201e'; fi
# Marea, as a program of the session (layer-shell), as she is on Hyprland.
marea start
# Whoever asks for your password when a program needs root (mounting a disk,
# a system tool): the first polkit agent installed. With none, those programs
# fail without asking. On another compositor you already start your own.
wm: for a in /usr/lib/hyprpolkitagent/hyprpolkitagent /usr/libexec/hyprpolkitagent /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/polkit-kde-authentication-agent-1 /usr/libexec/polkit-kde-authentication-agent-1 /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 /usr/bin/lxqt-policykit-agent; do [ -x "$a" ] && exec "$a"; done; echo "autostart · no polkit agent installed (hyprpolkitagent, polkit-gnome…)" >&2
